<odoo>
  
  <record id="upomax_premio_form_view" model="ir.ui.view">
    <field name="name">upomax.premio.form</field>
    <field name="model">upomax.premio</field>
    <field name="arch" type="xml">
      <form string="Premio">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="categoria" />
            <field name="ano" />
            
            <separator string="Ganador"/>
            <group>
                <field name="titulo_serie" />
                <field name="titulo_pelicula" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upomax_premio_list_view" model="ir.ui.view">
    <field name="name">upomax.premio.list</field>
    <field name="model">upomax.premio</field>
    <field name="arch" type="xml">
      <list string="Premios">
        <field name="name" />
        <field name="categoria" />
        <field name="ano" />
        
        <field name="obra_nombre" />
        
        <field name="tipo_obra" widget="badge" 
               decoration-info="tipo_obra == 'serie'" 
               decoration-success="tipo_obra == 'pelicula'"/>
      </list>
    </field>
  </record>

   <record id="upomax_premio_graph_view" model="ir.ui.view">
    <field name="name">upomax.premio.graph</field>
    <field name="model">upomax.premio</field>
    <field name="arch" type="xml">
      <graph string="Analisis de Premios" type="bar">
        <field name="categoria"/> 
      </graph>
    </field>
  </record>

  <record id="upomax_premio_search_view" model="ir.ui.view">
    <field name="name">upomax.premio.search</field>
    <field name="model">upomax.premio</field>
    <field name="arch" type="xml">
      <search string="Buscar Premio">
        <field name="name"/>
        <field name="categoria"/>
        <separator/>
        
        </search>
    </field>
  </record>
  
  <record id="premio_list_action" model="ir.actions.act_window">
    <field name="name">Premios</field>
    <field name="res_model">upomax.premio</field>
    <field name="view_mode">list,form,graph</field>
    <field name="search_view_id" ref="upomax_premio_search_view"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer premio</p>
    </field>
  </record>

</odoo>