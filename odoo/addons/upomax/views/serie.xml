<odoo>
  <record id="upomax_serie_form_view" model="ir.ui.view">
    <field name="name">upomax.serie.form</field>
    <field name="model">upomax.serie</field>
    <field name="arch" type="xml">
      <form string="Serie">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="fecha_emision" />
            <field name="fecha_finalizacion" />
            <field name="duracion" />
            <field name="plataformas_ids" widget="many2many_tags"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upomax_serie_list_view" model="ir.ui.view">
    <field name="name">upomax.serie.list</field>
    <field name="model">upomax.serie</field>
    <field name="arch" type="xml">
      <list string="list_string">
          <field name="name" />
          <field name="fecha_emision" />
          <field name="fecha_finalizacion" />
          <field name="duracion" />
          <field name="plataformas_ids" widget="many2many_tags"/>
      </list>
    </field>
  </record>

  <record id="serie_list_action" model="ir.actions.act_window">
    <field name="name">Serie</field>
    <field name="res_model">upomax.serie</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first serie</p>
    </field>
  </record>

  ---
  ---

  <record id="upomax_plataforma_tree_view" model="ir.ui.view">
      <field name="name">upomax.plataforma.tree</field>
      <field name="model">upomax.plataforma</field> 
      <field name="arch" type="xml">
          <list string="Plataformas">
              <field name="name"/>
          </list>
      </field>
  </record>

  <record id="upomax_plataforma_form_view" model="ir.ui.view">
      <field name="name">upomax.plataforma.form</field>
      <field name="model">upomax.plataforma</field>
      <field name="arch" type="xml">
          <form string="Plataforma">
              <sheet>
                  <group>
                      <field name="name"/>
                  </group>
              </sheet>
          </form>
      </field>
  </record>

</odoo>