<odoo>

  <record id="upomax_reparto_simple_tree" model="ir.ui.view">
    <field name="name">upomax.reparto.simple.tree</field>
    <field name="model">upomax.persona.tipo</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="tipo_id" column_invisible="True"/> 
        <field name="persona_id"/>
      </list>
    </field>
  </record>

  <record id="upomax_reparto_actor_tree" model="ir.ui.view">
    <field name="name">upomax.reparto.actor.tree</field>
    <field name="model">upomax.persona.tipo</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="tipo_id" column_invisible="True"/>
        <field name="persona_id"/>
        <field name="personaje"/>
      </list>
    </field>
  </record>

  <record id="upomax_serie_form_view" model="ir.ui.view">
    <field name="name">upomax.serie.form</field>
    <field name="model">upomax.serie</field>
    <field name="arch" type="xml">
      <form string="Serie">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="fecha_emision" />
            <field name="fecha_finalizacion" />
            <field name="duracion" />
            <field name="puntuacion_general"/>
            <field name="edad_recomendada"/>
            <field name="plataformas_ids" widget="many2many_tags"/>
          </group>

          <notebook>
            <page string="Reparto">
                <group string="Dirección">
                    <field name="directores_ids" 
                           context="{'default_tipo_id': %(upomax.tipo_director)d, 'tree_view_ref': 'upomax.upomax_reparto_simple_tree'}"/>
                </group>

                <group string="Actores">
                    <field name="actores_ids" 
                           context="{'default_tipo_id': %(upomax.tipo_actor)d, 'tree_view_ref': 'upomax.upomax_reparto_actor_tree'}"/>
                </group>

                <group string="Compositores">
                    <field name="compositores_ids" 
                           context="{'default_tipo_id': %(upomax.tipo_compositor)d, 'tree_view_ref': 'upomax.upomax_reparto_simple_tree'}"/>
                </group>
            </page>

            <page string="General">
                 <field name="participacion_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upomax_serie_list_view" model="ir.ui.view">
    <field name="name">upomax.serie.list</field>
    <field name="model">upomax.serie</field>
    <field name="arch" type="xml">
      <list string="Series">
          <field name="name" />
          <field name="puntuacion_general"/>
          <field name="fecha_emision" />
      </list>
    </field>
  </record>

  <record id="upomax_serie_search_view" model="ir.ui.view">
    <field name="name">upomax.serie.search</field>
    <field name="model">upomax.serie</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
      </search>
    </field>
  </record>

  <record id="serie_list_action" model="ir.actions.act_window">
    <field name="name">Serie</field>
    <field name="res_model">upomax.serie</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>