<odoo>

  <record id="upomax_usuario_form_view" model="ir.ui.view">
    <field name="name">upomax.usuario.form</field>
    <field name="model">upomax.usuario</field>
    <field name="arch" type="xml">
      <form string="Usuario">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="correo_Electronico" />
            <field name="contrasenya" />
            <field name="biografia" />
            <field name="reviews_ids" />
            <field name="amigos_ids" widget="many2many_tags"/>
          </group>
          <notebook>
              <page string="Listas">
                  <field name="lista_ids"/>
              </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upomax_usuario_list_view" model="ir.ui.view">
    <field name="name">upomax.usuario.list</field>
    <field name="model">upomax.usuario</field>
    <field name="arch" type="xml">
      <list string="Usuarios">
        <field name="name" />
        <field name="correo_Electronico" />
        <field name="biografia" />
        <field name="reviews_ids" />
      </list>
    </field>
  </record>

  <record id="view_usuario_form_ai" model="ir.ui.view">
    <field name="name">upomax.usuario.form.ai</field>
    <field name="model">upomax.usuario</field>
    <field name="inherit_id" ref="upomax.upomax_usuario_form_view"/>
    <field name="arch" type="xml">
        <xpath expr="//sheet" position="before">
            <header>
                <button name="action_generar_recomendaciones" 
                        string="✨ Generar Recomendaciones IA" 
                        type="object" 
                        class="oe_highlight"/>
            </header>
        </xpath>
        <xpath expr="//sheet" position="inside">
            <group string="Inteligencia Artificial">
                <field name="recomendaciones_texto" />
            </group>
        </xpath>
    </field>
  </record>

  <record id="usuario_list_action" model="ir.actions.act_window">
    <field name="name">Usuarios</field>
    <field name="res_model">upomax.usuario</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer usuario</p>
    </field>
  </record>

</odoo>
