<odoo>

  <record id="upomax_franquicia_form_view" model="ir.ui.view">
    <field name="name">upomax.franquicia.form</field>
    <field name="model">upomax.franquicia</field>
    <field name="arch" type="xml">
      <form string="Franquicia">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="descripcion" />
            <field name="anio_inicio" />
            <field name="estado" />
            <field name="peliculas_ids" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upomax_franquicia_list_view" model="ir.ui.view">
    <field name="name">upomax.franquicia.list</field>
    <field name="model">upomax.franquicia</field>
    <field name="arch" type="xml">
      <list string="Franquicias">
        <field name="name" />
        <field name="descripcion" />
        <field name="anio_inicio" />
        <field name="estado" />
        <field name="peliculas_ids" />
      </list>
    </field>
  </record>

  <record id="upomax_franquicia_graph_view" model="ir.ui.view">
    <field name="name">upomax.franquicia.graph</field>
    <field name="model">upomax.franquicia</field>
    <field name="arch" type="xml">
     <graph>
      <field name="name"/>
      <field name="peliculas_count" type ="measure"/>
     
     
     </graph>
    </field>
  </record>

  <record id="franquicia_list_action" model="ir.actions.act_window">
    <field name="name">Franquicia</field>
    <field name="res_model">upomax.franquicia</field>
    <field name="view_mode">list,form,graph</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crea la primera franquicia
      </p>
    </field>
  </record>

</odoo>