<odoo>
    <data>
        <record model="ir.ui.view" id="main_menu_form_view">
            <field name="name">upomax.main_menu.form</field>
            <field name="model">upomax.main_menu</field>
            <field name="arch" type="xml">
                <form create="false" edit="false" delete="false" class="oe_form_nosheet" string="Menú Principal">
                    
                    <style>
                        .o_control_panel {
                            display: none !important;
                        }
                    </style>
                    <div class="container-fluid">
                        <div class="row justify-content-center">
                            <div class="col-md-8">
                                <div class="text-center mb-4">
                                    <h1 class="display-4 text-primary">Bienvenido a UPOMAX</h1>
                                    <p class="lead">Selecciona una opción para gestionar el contenido multimedia</p>
                                </div>
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body text-center">
                                                <i class="fa fa-film fa-3x text-primary mb-3"></i>
                                                <h5 class="card-title">Series</h5>
                                                <button name="action_series" string="Gestionar Series" type="object" class="btn btn-primary btn-block">Acceder</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body text-center">
                                                <i class="fa fa-video-camera fa-3x text-success mb-3"></i>
                                                <h5 class="card-title">Películas</h5>
                                                <button name="action_peliculas" string="Gestionar Películas" type="object" class="btn btn-success btn-block">Acceder</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body text-center">
                                                <i class="fa fa-tv fa-3x text-info mb-3"></i>
                                                <h5 class="card-title">Plataformas</h5>
                                                <button name="action_plataformas" string="Gestionar Plataformas" type="object" class="btn btn-info btn-block">Acceder</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body text-center">
                                                <i class="fa fa-users fa-3x text-warning mb-3"></i>
                                                <h5 class="card-title">Personas</h5>
                                                <button name="action_personas" string="Gestionar Personas" type="object" class="btn btn-warning btn-block">Acceder</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body text-center">
                                                <i class="fa fa-star fa-3x text-danger mb-3"></i>
                                                <h5 class="card-title">Reviews</h5>
                                                <button name="action_reviews" string="Gestionar Reviews" type="object" class="btn btn-danger btn-block">Acceder</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body text-center">
                                                <i class="fa fa-user fa-3x text-secondary mb-3"></i>
                                                <h5 class="card-title">Usuarios</h5>
                                                <button name="action_usuarios" string="Gestionar Usuarios" type="object" class="btn btn-secondary btn-block">Acceder</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="main_menu_action">
            <field name="name">Menú Principal</field>
            <field name="res_model">upomax.main_menu</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="main_menu_form_view"/>
            <field name="target">current</field>
        </record>

        <menuitem name="UPOMAX" id="main_upomax_menu" action="main_menu_action" groups="group_upomax_manager"/>
    </data>
</odoo>