<odoo>
  <record id="upomax_persona_form_view" model="ir.ui.view">
    <field name="name">upomax.persona.form</field>
    <field name="model">upomax.persona</field>
    <field name="arch" type="xml">
      <form string="Persona">
        <sheet layout="auto">
          <group>
            <field name="nombre" />
            <field name="apellidos" />
            <field name="edad" />
            <field name="biografia" />
                
            <!-- <field name="plataformas_ids" widget="many2many_tags"/> -->
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upomax_persona_list_view" model="ir.ui.view">
    <field name="name">upomax.persona.list</field>
    <field name="model">upomax.persona</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="nombre" />
            <field name="apellidos" />
            <field name="edad" />
            
            <!-- <field name="plataformas_ids" widget="many2many_tags"/> -->
      </list>
    </field>
  </record>

  <record id="personas_list_action" model="ir.actions.act_window">
    <field name="name">persona</field>
    <field name="res_model">upomax.persona</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first persona</p>
    </field>
  </record>

</odoo>