<odoo>
  <record id="upomax_persona_form_view" model="ir.ui.view">
    <field name="name">upomax.persona.form</field>
    <field name="model">upomax.persona</field>
    <field name="arch" type="xml">
      <form string="Persona">
        <sheet layout="auto">
          <group>
            <field name="nombre" />
            <field name="apellidos" />
            <field name="edad" />
            <field name="biografia" />
        
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upomax_persona_list_view" model="ir.ui.view">
    <field name="name">upomax.persona.list</field>
    <field name="model">upomax.persona</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="nombre" />
            <field name="apellidos" />
            <field name="edad" />
      </list>
    </field>
  </record>

   <record id="personas_list_action" model="ir.actions.act_window">
    <field name="name">persona</field>
    <field name="res_model">upomax.persona</field>
    <field name="view_mode">list,form,graph</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first persona</p>
    </field>
  </record>


  <record id="upomax_persona_graph_view" model="ir.ui.view">
    <field name="name">upomax.persona.graph</field>
    <field name="model">upomax.persona</field>
    <field name="arch" type="xml">
      <graph string="Edades de de actores, directores o compositores" type="pie" >
            <field name="nombre" />
            <field name="edad" type="measure"/>
      </graph>
    </field>
  </record>



</odoo>