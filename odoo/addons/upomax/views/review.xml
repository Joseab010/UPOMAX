<odoo>

  
  <record id="upomax_review_form_view" model="ir.ui.view">
    <field name="name">upomax.review.form</field>
    <field name="model">upomax.review</field>
    <field name="arch" type="xml">
      <form string="Review">
        <sheet layout="auto">
          <group>
            <field name="titulo" />
            <field name="calificacion" />
            <field name="comentario" />
            <field name="fecha" />
            <field name="like" />
            <field name="id_usuario" />
            <field name="serie_id" />
            <field name="pelicula_id" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  
  <record id="upomax_review_list_view" model="ir.ui.view">
    <field name="name">upomax.review.list</field>
    <field name="model">upomax.review</field>
    <field name="arch" type="xml">
      <list string="Reviews">
        <field name="titulo" />
        <field name="calificacion" />
        <field name="fecha" />
        <field name="like" />
        <field name="id_usuario" />
        <field name="serie_id" />
        <field name="pelicula_id" />
      </list>
    </field>
  </record>

  <record id="upomax_review_search_view" model="ir.ui.view">
    <field name="name">upomax.review.search</field>
    <field name="model">upomax.review</field>
    <field name="arch" type="xml">
      <search>
       

        <filter string="Con mas de 5 puntos" name="aprobadas" domain="[('calificacion', '>=', 5)]"/>
        <filter string="Con menos de 5 puntos" name="suspensas" domain="[('calificacion', '&lt;', 5)]"/>

        <group>
            <filter string="Calificacíon" name="group_calificacion" context="{'group_by': 'calificacion'}"/>
            <filter string="Usuario" name="group_usuario" context="{'group_by': 'id_usuario'}"/>
            <filter string="Pelicula" name="group_pelicula" context="{'group_by': 'pelicula_id'}"/>
            <filter string="Serie" name="group_serie" context="{'group_by': 'serie_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="review_calendar_view" model="ir.ui.view">
    <field name="name">review.calendar</field>
    <field name="model">upomax.review</field>
    <field name="arch" type="xml">
      <calendar string="Reviews" color="calificacion" date_start="fecha" mode="month">
        <field name="titulo" />
        <field name="calificacion" />
        <field name="id_usuario" />
      </calendar>
    </field>
  </record>


  
  <record id="review_list_action" model="ir.actions.act_window">
    <field name="name">Reviews</field>
    <field name="res_model">upomax.review</field>
    <field name="view_mode">list,form,calendar</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera review</p>
    </field>
  </record>

  <!-- OWL Client Action para gestionar reviews -->
  <record id="action_owl_ReviewsComponente_js" model="ir.actions.client">
    <field name="name">Gestor de Reviews OWL</field>
    <field name="tag">upomax.action_ReviewsComponente_js</field>
  </record>

</odoo>
