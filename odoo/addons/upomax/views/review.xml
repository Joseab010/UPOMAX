<odoo>

  
  <record id="upomax_review_form_view" model="ir.ui.view">
    <field name="name">upomax.review.form</field>
    <field name="model">upomax.review</field>
    <field name="arch" type="xml">
      <form string="Review">
        <sheet layout="auto">
          <group>
            <field name="titulo" />
            <field name="calificacion" />
            <field name="comentario" />
            <field name="fecha" />
            <field name="like" />
            <field name="id_usuario" />
            <field name="serie_id" />
            <field name="pelicula_id" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  
  <record id="upomax_review_list_view" model="ir.ui.view">
    <field name="name">upomax.review.list</field>
    <field name="model">upomax.review</field>
    <field name="arch" type="xml">
      <list string="Reviews">
        <field name="titulo" />
        <field name="calificacion" />
        <field name="fecha" />
        <field name="like" />
        <field name="id_usuario" />
        <field name="serie_id" />
        <field name="pelicula_id" />
      </list>
    </field>
  </record>

  
  <record id="review_list_action" model="ir.actions.act_window">
    <field name="name">Reviews</field>
    <field name="res_model">upomax.review</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera review</p>
    </field>
  </record>

</odoo>
