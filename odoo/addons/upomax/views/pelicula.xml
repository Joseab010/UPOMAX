<odoo>
  <record id="upomax_pelicula_form_view" model="ir.ui.view">
    <field name="name">upomax.pelicula.form</field>
    <field name="model">upomax.pelicula</field>
    <field name="arch" type="xml">
      <form string="Pelicula">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="descripcion" />
            <field name="puntuacion_general" />
            <field name="anio" />
            <field name="edad_recomendada" />
            <field name="duracion" />
            
            <field name="plataformas_ids" widget="many2many_tags"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upomax_pelicula_list_view" model="ir.ui.view">
    <field name="name">upomax.pelicula.list</field>
    <field name="model">upomax.pelicula</field>
    <field name="arch" type="xml">
      <list string="list_string">
           <field name="name" />
            <field name="descripcion" />
            <field name="puntuacion_general" />
            <field name="anio" />
            <field name="edad_recomendada" />
            <field name="duracion" />
            
            <field name="plataformas_ids" widget="many2many_tags"/>
      </list>
    </field>
  </record>

  <record id="peliculas_list_action" model="ir.actions.act_window">
    <field name="name">Pelicula</field>
    <field name="res_model">upomax.pelicula</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first pelicula</p>
    </field>
  </record>

  ---
  ---

  <record id="upomax_plataforma_tree_view" model="ir.ui.view">
      <field name="name">upomax.plataforma.tree</field>
      <field name="model">upomax.plataforma</field> 
      <field name="arch" type="xml">
          <list string="Plataformas">
              <field name="name"/>
          </list>
      </field>
  </record>

  <record id="upomax_plataforma_form_view" model="ir.ui.view">
      <field name="name">upomax.plataforma.form</field>
      <field name="model">upomax.plataforma</field>
      <field name="arch" type="xml">
          <form string="Plataforma">
              <sheet>
                  <group>
                      <field name="name"/>
                  </group>
              </sheet>
          </form>
      </field>
  </record>

</odoo>