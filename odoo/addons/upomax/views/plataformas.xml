<odoo>
  <record id="upomax_plataforma_tree_view" model="ir.ui.view">
    <field name="name">upomax.plataforma.tree</field>
    <field name="model">upomax.plataforma</field>
    <field name="arch" type="xml">
      <list string="Plataformas">
        <field name="name"/>
      </list>
    </field>
  </record>

  <record id="upomax_plataforma_form_view" model="ir.ui.view">
    <field name="name">upomax.plataforma.form</field>
    <field name="model">upomax.plataforma</field>
    <field name="arch" type="xml">
      <form string="Plataforma">
        <sheet>
          <group>
            <field name="name"/>
          </group>
          <notebook>
            <page string="Series">
              <field name="series_ids"/>
              </page>
            <page string="Películas">
            <field name="peliculas_ids"/>
          
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="plataforma_list_action" model="ir.actions.act_window">
    <field name="name">Plataformas</field>
    <field name="res_model">upomax.plataforma</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Menu -->
</odoo>
