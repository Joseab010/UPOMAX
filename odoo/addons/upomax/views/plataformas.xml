<odoo>
  <record id="upomax_plataforma_form_view" model="ir.ui.view">
    <field name="name">upomax.plataforma.form</field>
    <field name="model">upomax.plataforma</field>
    <field name="arch" type="xml">
      <form string="Plataforma">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="series_ids" widget="many2many_tags"/>
            <field name="peliculas_ids" widget="many2many_tags"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upomax_plataforma_list_view" model="ir.ui.view">
    <field name="name">upomax.plataforma.list</field>
    <field name="model">upomax.plataforma</field>
    <field name="arch" type="xml">
      <tree string="Listado de Plataformas"> 
            <field name="name" />
            <field name="series_count"/>
            <field name="peliculas_count"/>
      </tree>
    </field>
  </record>

  <record id="upomax_plataforma_graph_view" model="ir.ui.view">
    <field name="name">upomax.plataforma.graph</field>
    <field name="model">upomax.plataforma</field>
    <field name="arch" type="xml">
      <graph string="Cuota de Mercado" type="pie">
            <field name="name"/>
            <field name="peliculas_count" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="plataforma_list_action" model="ir.actions.act_window">
    <field name="name">Plataformas</field>
    <field name="res_model">upomax.plataforma</field>
    <field name="view_mode">tree,form,graph</field>
  </record>

</odoo>
