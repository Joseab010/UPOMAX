<odoo>

  <record id="upomax_productora_form_view" model="ir.ui.view">
    <field name="name">upomax.productora.form</field>
    <field name="model">upomax.productora</field>
    <field name="arch" type="xml">
      <form string="Productora">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="fundacion" />
            <field name="pais" />
          
            <field name="peliculas_ids" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upomax_productora_list_view" model="ir.ui.view">
    <field name="name">upomax.productora.list</field>
    <field name="model">upomax.productora</field>
    <field name="arch" type="xml">
      <list string="Productoras">
       <field name="name" />
            <field name="fundacion" />
            <field name="pais" />
          
            <field name="peliculas_ids" />
      </list>
    </field>
  </record>

  <record id="upomax_productora_search_view" model="ir.ui.view">
    <field name="name">upomax.productora.search</field>
    <field name="model">upomax.productora</field>
    <field name="arch" type="xml">
      <search>
       

        <filter string="Fundacion mayor 2000" name="2000" domain="[('fundacion', '&gt;=', '2000-01-01')]"/>
        <filter string="Fundacion menor  2000" name="pre-2000" domain="[('fundacion', '&lt;', '2000-01-01')]"/>
        
        <filter string="Americanas" name="americanas" domain="['|', ('pais', '=', 'Estados Unidos'), ('pais', '=', 'Canadá')]"/>
        <filter string="Europeas" name="uk" domain="[('pais', '=', 'Reino Unido')]"/>
        
       

        <group>
            <filter string="País" name="group_pais" context="{'group_by': 'pais'}"/>
            
            <filter string="Fecha Fundación" name="group_fundacion" context="{'group_by': 'fundacion'}"/>
        </group>
      </search>
    </field>
  </record>



  <record id="upomax_productora_graph_view" model="ir.ui.view">
    <field name="name">upomax.productora.graph</field>
    <field name="model">upomax.productora</field>
    <field name="arch" type="xml">
      <graph>
        <field name="name"/>
        <field name="peliculas_count" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="productora_list_action" model="ir.actions.act_window">
    <field name="name">Productora</field>
    <field name="res_model">upomax.productora</field>
    <field name="view_mode">list,form,graph</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crea la primera productora
      </p>
    </field>
  </record>

</odoo>