<odoo>
  <record id="upomax_pelicula_form_view" model="ir.ui.view">
    <field name="name">upomax.pelicula.form</field>
    <field name="model">upomax.peliculas</field>
    <field name="arch" type="xml">
      <form string="Pelicula">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="descripcion" />
            <field name="puntuacion_general" />
            <field name="anio" />
            <field name="edad_recomendada" />
            <field name="duracion" />
            
            <field name="plataformas_ids" widget="many2many_tags"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upomax_pelicula_list_view" model="ir.ui.view">
    <field name="name">upomax.pelicula.list</field>
    <field name="model">upomax.peliculas</field>
    <field name="arch" type="xml">
      <list string="list_string">
           <field name="name" />
            <!-- <field name="descripcion" /> -->
            <field name="puntuacion_general" />
            <field name="anio" />
            <field name="edad_recomendada" />
            <field name="duracion" />
            
            <field name="plataformas_ids" widget="many2many_tags"/>
      </list>
    </field>
  </record>

  <record id="peliculas_list_action" model="ir.actions.act_window">
    <field name="name">Peliculas</field>
    <field name="res_model">upomax.peliculas</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first pelicula</p>
    </field>
  </record>

</odoo>