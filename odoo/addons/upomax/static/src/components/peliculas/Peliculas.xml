<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="upomax.PeliculasComponente" owl="1">
        <div class="PeliculasComponente-container">

            <div class="row mx-2 mt-3">
                <div class="col-lg-6">
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#peliculasModal" t-on-click="addPelicula">
                        <i class="fa fa-plus"></i> Nueva Película
                    </button>
                </div>
                <div class="col-lg-6">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Buscar por título..." t-ref="search-input" t-on-keyup="searchPeliculas"/>
                        <button class="btn btn-outline-primary" t-on-click="searchPeliculas">
                            <i class="fa fa-search"></i> Buscar
                        </button>
                    </div>
                </div>
            </div>

            <div class="row m-2">
                <div class="col">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover border">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col">Título</th>
                                <th scope="col">Año</th>
                                <th scope="col">Duración (min)</th>
                                <th scope="col">Edad Recomendada</th>
                                <th scope="col">Puntuación</th>
                                <th scope="col">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.peliculaList" t-as="pelicula" t-key="pelicula.id">
                                <td>
                                    <strong t-esc="pelicula.name"/>
                                </td>
                                <td t-esc="pelicula.anio"/>
                                <td>
                                    <input type="number" class="form-control form-control-sm" t-att-value="pelicula.duracion" t-on-change="(e) => this.updateDuracion(e, pelicula)"/>
                                </td>
                                <td>
                                    <span class="badge bg-info">+<t t-esc="pelicula.edad_recomendada"/></span>
                                </td>
                                <td>
                                    <span class="badge bg-success" t-if="pelicula.puntuacion_general > 0">
                                        <t t-esc="pelicula.puntuacion_general.toFixed(1)"/> / 10
                                    </span>
                                    <span class="badge bg-secondary" t-else="">Sin valorar</span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#peliculasModal" t-on-click="() => this.editPelicula(pelicula)">
                                        <i class="fa fa-edit"></i> Editar
                                    </button>
                                    <button class="btn btn-sm btn-danger" t-on-click="() => this.deletePelicula(pelicula)">
                                        <i class="fa fa-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>

            <!-- Modal para crear/editar película -->
            <div class="modal fade" id="peliculasModal" tabindex="-1" aria-labelledby="peliculasModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header bg-primary text-white">
                            <h1 class="modal-title fs-5" id="peliculasModalLabel">
                                <t t-if="state.isEdit">Editar Película</t>
                                <t t-else="">Añadir Nueva Película</t>
                            </h1>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">

                            <!-- Título -->
                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Título</label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" id="name" t-model="state.pelicula.name" placeholder="Ej. Inception"/>
                                </div>
                            </div>

                            <!-- Año -->
                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Año de Estreno</label>
                                <div class="col-sm-9">
                                    <input type="number" class="form-control" id="anio" t-model="state.pelicula.anio" placeholder="2010"/>
                                </div>
                            </div>

                            <!-- Duración -->
                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Duración (minutos)</label>
                                <div class="col-sm-9">
                                    <input type="number" class="form-control" id="duracion" t-model="state.pelicula.duracion" placeholder="148"/>
                                </div>
                            </div>

                            <!-- Edad Recomendada -->
                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Edad Recomendada</label>
                                <div class="col-sm-9">
                                    <input type="number" class="form-control" id="edad_recomendada" t-model="state.pelicula.edad_recomendada" min="0" max="18" placeholder="13"/>
                                </div>
                            </div>

                            <!-- Descripción -->
                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Descripción</label>
                                <div class="col-sm-9">
                                    <textarea class="form-control" id="descripcion" t-model="state.pelicula.descripcion" rows="3" placeholder="Sinopsis de la película..."></textarea>
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            <button type="button" class="btn btn-primary" t-on-click="savePelicula">
                                <i class="fa fa-save"></i> Guardar Película
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </t>
</templates>
