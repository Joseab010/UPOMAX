<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="series_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="web.external_layout">

          <div class="page">

            <div class="row mb-4"> <!-- CABECERA DE LA SERIE -->
              <div class="col-12 text-center">
                <h1 class="text-uppercase text-primary">
                  <span t-field="doc.name" />
                </h1>
                <h5 class="text-muted">
                  <span t-field="doc.fecha_emision" /> | <span t-field="doc.duracion" /> min </h5>
              </div>
            </div>

            <!-- TÍTULO DE FICHA TÉCNICA -->
            <div class="row mb-3">
              <div class="col-12">
                <div class="card-header bg-primary text-white text-center">
                  <strong>Ficha Técnica</strong>
                </div>
              </div>
            </div>

            <!-- TABLA CON FICHA TÉCNICA -->
            <div class="row">

              <!-- COLUMNA IZQUIERDA -->
              <div class="col-12">

                <div class="card border-primary mb-3">
                  <div class="card-body p-0">
                    <table class="table table-sm table-striped mb-0">
                      <tbody>
                        <tr>
                          <td>
                            <strong>Puntuación general:</strong>
                          </td>
                          <td class="text-right">
                            <span t-field="doc.puntuacion_general" /> / 10 </td>
                          <td>
                            <strong>Calificación de edad:</strong>
                          </td>
                          <td class="text-right"> +<span
                              t-field="doc.edad_recomendada" /> años</td>
                        </tr>
                        <tr>
                          <td>
                            <strong>Fecha de emisión:</strong>
                          </td>
                          <td class="text-right">
                            <span t-field="doc.fecha_emision" />
                          </td>
                          <td>
                            <strong>Fecha de finalización</strong>
                          </td>
                          <td class="text-right">
                            <span t-field="doc.fecha_finalizacion" />
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>

                <div class="mt-3">
                  <div class="d-flex flex-wrap">
                    <strong>Géneros:</strong>
                    <t t-foreach="doc.generos_ids" t-as="genero">
                      <span
                        class="badge badge-info mr-1 p-2"
                        t-field="genero.name" />
                    </t>
                  </div>
                </div>

                <div class="mt-3">
                  <div class="d-flex flex-wrap">
                    <strong>Disponible en:</strong>
                    <t t-foreach="doc.plataformas_ids" t-as="plat">
                      <span
                        class="badge badge-warning text-dark mr-1 p-2"
                        t-field="plat.name" />
                    </t>
                  </div>
                </div>
              </div>

            </div>
            <!-- TABLA DE EPISODIOS POR TEMPORADA -->
            <div class="row mt-5">
              <div>
                <div class="card-header bg-primary text-white text-center">
                  <strong>Información de temporadas</strong>
                </div>
              </div>
            </div>
            <div class="row mt-6">

              <table class="table table-sm table-striped mb-0">
                <thead>
                  <tr>
                    <th>
                      <strong>Nº de Temporada</strong>
                    </th>
                    <th>
                      <strong>Nombre de Temporada</strong>
                    </th>
                    <th class="text-right">
                      <strong>Cantidad de Episodios</strong>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="doc.temporadas_ids" t-as="temp">
                    <tr>
                      <td>
                        <span t-field="temp.num_temporada" />
                      </td>
                      <td>
                        <span t-field="temp.name" />
                      </td>
                      <td class="text-right">
                        <span t-field="temp.cantidad_capitulos" />
                      </td>
                    </tr>
                  </t>
                </tbody>
              </table>
            </div>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>