<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="peliculas_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="web.external_layout">
          
          <div class="page">
            
            <div class="row mb-4"> <div class="col-12 text-center">
                    <h1 class="text-uppercase text-primary"> <span t-field="doc.name"/>
                    </h1>
                    <h5 class="text-muted"> <span t-field="doc.anio"/> | <span t-field="doc.duracion"/> min
                    </h5>
                </div>
            </div>

            <div class="row">
                
                <div class="col-6">
                    <div class="card border-primary mb-3"> <div class="card-header bg-primary text-white"> <strong>Ficha Técnica</strong>
                        </div>
                        <div class="card-body p-0"> <table class="table table-sm table-striped mb-0"> <tbody>
                                    <tr>
                                        <td><strong>Calificación:</strong></td>
                                        <td class="text-right">
                                            <span t-field="doc.puntuacion_general"/> / 10
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Edad:</strong></td>
                                        <td class="text-right">
                                            +<span t-field="doc.edad_recomendada"/> años
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Estreno:</strong></td>
                                        <td class="text-right">
                                            <span t-field="doc.anio"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="mt-3">
                        <p><strong>Géneros:</strong></p>
                        <t t-foreach="doc.generos_ids" t-as="genero">
                            <span class="badge badge-info mr-1 p-2" t-field="genero.name"/>
                        </t>
                    </div>
                </div>

                <div class="col-6">
                    <div class="alert alert-secondary" role="alert"> <h4 class="alert-heading">Sinopsis</h4>
                        <p class="mb-0 text-justify" style="font-size: 14px;"> <span t-field="doc.descripcion"/>
                        </p>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <strong>Disponible en:</strong>
                            <div class="d-flex flex-wrap"> <t t-foreach="doc.plataformas_ids" t-as="plat">
                                    <span class="badge badge-warning text-dark mr-2 mt-1" t-field="plat.name"/>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <small class="text-muted">Producido por:</small><br/>
                            <t t-foreach="doc.productoras_ids" t-as="prod">
                                <span class="text-dark font-weight-bold" t-field="prod.name"/>
                                <span t-if="not prod_last">, </span> </t>
                        </div>
                    </div>
                </div>
            </div>
          </div>
        </t> 
      </t> 
    </t> 
  </template>
</odoo>