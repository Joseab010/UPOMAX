<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="peliculas_template">
    
    <t t-call="web.html_container">
      
      <t t-foreach="docs" t-as="doc">
        
        <t t-call="web.external_layout">
          
          <div class="page">
            <h2 t-field="doc.name"/>
            
            <p><strong>Título:</strong> <span t-field="doc.name"/></p>
            <p><strong>Descripción:</strong> <span t-field="doc.descripcion"/></p>
            <p><strong>Género:</strong> <span t-field="doc.generos_ids"/></p>
            <p><strong>Fecha de estreno:</strong> <span t-field="doc.anio"/></p>
            <p><strong>Calificación:</strong> <span t-field="doc.puntuacion_general"/></p>
          </div>
          
        </t> </t> </t> </template>
</odoo>