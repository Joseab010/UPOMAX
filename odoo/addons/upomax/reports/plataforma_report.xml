<odoo>
    <template id="plataforma_template">
        <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
        <t t-call="web.external_layout">
             <div class="page">
            <h2 t-esc="doc.name"/>
             <p>
    <strong>Series:</strong>
    <span t-esc="doc.series_ids"/>
    </p>
    <p>
    <strong>Peliculas:</strong>
    <span t-esc="doc.peliculas_ids"/>
    </p>
    <p>
    <strong>Numero de Series:</strong>
    <span t-esc="doc.series_count"/>
    </p>
    <p>
    <strong>Numero de peliculas:</strong>
    <span t-esc="doc.peliculas_count"/>
    </p>
       </div>
        </t>
        </t>
        </t>
    </template>
</odoo>