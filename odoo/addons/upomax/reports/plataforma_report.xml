<odoo>
    <template id="plataforma_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        
                        <div class="text-center mt-4 mb-5 p-4 text-white rounded shadow-sm" >
                            <h1 class="display-4 font-weight-bold">
                                <i class="fa fa-desktop"/> <span t-field="doc.name"/>
                            </h1>
                            <h5 class="text-uppercase" style="opacity: 0.8;">Informe de Contenido Oficial</h5>
                        </div>

                        <div class="row mb-5">
                            
                            <div class="col-6">
                                <div class="card text-white shadow h-100 border-0" >
                                    <div class="card-body text-center">
                                        <h5 style="color: #875A7B;"><i class="fa fa-tv"/> Total Series</h5>
                                        <h2 class="font-weight-bold">
                                            <span t-field="doc.series_count"/>
                                        </h2>
                                        <small style="opacity: 0.7;">Registros activos</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card bg-white text-dark shadow h-100 border-0">
                                    <div class="card-body text-center">
                                        <h5 style="color: #875A7B;"><i class="fa fa-film"/> Total Películas</h5>
                                        <h2 class="font-weight-bold text-dark">
                                            <span t-field="doc.peliculas_count"/>
                                        </h2>
                                        <small class="text-muted">Registros activos</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            
                            <div class="col-6 pr-4"> 
                                <h4 class="mb-3 border-bottom pb-2" style="color: #875A7B;">
                                    <i class="fa fa-list-ul"/> Catálogo de Series
                                </h4>
                                
                                <t t-if="doc.series_ids">
                                    <table class="table table-sm table-hover mt-3">
                                        <thead class="text-white" >
                                            <tr>
                                                <th>Nombre del Título</th>
                                            </tr> 
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="doc.series_ids" t-as="serie">
                                                <td class="pl-3"><span t-field="serie.name"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-light border text-center text-muted mt-3" role="alert">
                                        <i class="fa fa-info-circle"/> No hay series registradas.
                                    </div>
                                </t>
                            </div>

                            <div class="col-6 pl-4"> 
                                <h4 class="mb-3 text-dark border-bottom pb-2" style="color: #875A7B;">
                                    <i class="fa fa-ticket"/> Catálogo de Películas
                                </h4>

                                <t t-if="doc.peliculas_ids">
                                    <table class="table table-sm table-hover mt-3">
                                        <thead class="thead-light">
                                            <tr>
                                                <th>Nombre del Título</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="doc.peliculas_ids" t-as="pelicula">
                                                <td class="pl-3"><span t-field="pelicula.name"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-light border text-center text-muted mt-3" role="alert">
                                        <i class="fa fa-info-circle"/> No hay películas registradas.
                                    </div>
                                </t>
                            </div>
                        </div>

                        <div class="mt-5 pt-3 border-top text-right font-italic" style="color: #875A7B;">
                            <small>
                                <i class="fa fa-check-circle"/> Documento generado por UPOMAX el 
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                            </small>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>