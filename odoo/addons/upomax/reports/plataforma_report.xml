<odoo>
    <template id="plataforma_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h1 t-esc="doc.name"/>
                        <h5>Informe Oficial</h5>
                        <p>
                            <strong>Series:</strong>
                             <p>
                            <strong>Numero de Series:</strong>
                            <span t-esc="doc.series_count"/>
                            </p>
                            <ul>
                                <t t-foreach="doc.series_ids" t-as="serie">
                                    <li>
                                        <span t-field="serie.name"/>
                                    </li>
                                </t>
                            </ul>
                        </p>
                        
                        <p>
                            <strong>Peliculas:</strong>
                             <p>
                            <strong>Numero de peliculas:</strong>
                            <span t-esc="doc.peliculas_count"/>
                        </p>
                            <ul>
                                <t t-foreach="doc.peliculas_ids" t-as="pelicula">
                                    <li>
                                        <span t-field="pelicula.name"/>
                                    </li>
                                </t>
                            </ul>
                        </p>

                        
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>