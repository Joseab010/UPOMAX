<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="productora_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="web.basic_layout">
          
          <div class="page">
            <div class="container" style="margin-top: 20px; font-family: Helvetica, Arial, sans-serif;">

              <div class="row mb-4">
                <div class="col-12 text-center">
                    <h5 class="text-muted text-uppercase">Ficha de Productora</h5>
                    <h1 class="font-weight-bold" style="font-size: 50px;">
                        <span t-field="doc.name"/>
                    </h1>
                </div>
              </div>

              <div class="row mt-5">
                 <div class="col-12">
                     <h5 style="border-bottom: 3px solid #007bff; padding-bottom: 5px;" class="text-uppercase text-muted font-weight-bold">
                         Información General
                     </h5>
                 </div>
              </div>

              <div class="row mt-3">
                  <div class="col-6">
                      <span class="text-muted small text-uppercase">País de Origen:</span><br/>
                      <span class="h4 font-weight-bold" t-field="doc.pais"/>
                  </div>
                  <div class="col-6">
                      <span class="text-muted small text-uppercase">Fecha de Fundación:</span><br/>
                      <span class="h4 font-weight-bold" t-field="doc.fundacion"/>
                  </div>
              </div>

              <div class="row mt-5">
                  <div class="col-12">
                      <h5 style="color: #17a2b8;" class="text-uppercase font-weight-bold">
                          <i class="fa fa-film"></i> Producción Total
                      </h5>
                      <div class="p-4" style="background-color: #f8f9fa; border-top: 4px solid #17a2b8;">
                          
                          <div class="display-4 font-weight-bold text-dark">
                              <span t-field="doc.peliculas_count"/>
                          </div>
                          <div class="text-muted text-uppercase small">Películas registradas</div>
                          
                      </div>
                  </div>
              </div>

              <div class="row mt-5">
                 <div class="col-12">
                     <h5 style="border-bottom: 3px solid #28a745; padding-bottom: 5px;" class="text-uppercase text-muted font-weight-bold">
                         Catálogo de Películas
                     </h5>
                     <span class="badge badge-success rounded-pill px-3"><span t-field="doc.peliculas_count"/> películas</span>
                 </div>
              </div>

              <div class="row mt-3">
                  <div class="col-12">
                      <table class="table table-borderless table-striped mt-2">
                          <thead class="bg-light text-uppercase text-muted small">
                              <tr>
                                  <th>Título</th>
                                  <th class="text-right">Año Estreno</th>
                              </tr>
                          </thead>
                          <tbody>
                              <t t-foreach="doc.peliculas_ids" t-as="peli">
                                  <tr>
                                      <td class="align-middle">
                                          <span class="font-weight-bold" t-field="peli.name"/>
                                      </td>
                                      <td class="text-right align-middle">
                                          <span class="badge badge-light border" style="font-size: 14px;">
                                              <span t-field="peli.anio"/>
                                          </span>
                                      </td>
                                  </tr>
                              </t>
                          </tbody>
                      </table>
                      
                      <t t-if="not doc.peliculas_ids">
                          <div class="alert alert-warning mt-2 text-center">
                              No hay películas asociadas a esta productora.
                          </div>
                      </t>
                  </div>
              </div>

              <div class="footer text-center" style="border-top: 1px solid #ddd; margin-top: 50px; padding-top: 10px;">
                  <small class="text-muted">
                      Informe generado por UPOMAX | <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                  </small>
              </div>

            </div>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>