<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="peliculas_report" model="ir.actions.report">
        <field name="name">Películas</field>
        <field name="model">upomax.pelicula</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">upomax.peliculas_template</field>
        <field name="report_file">upomax.peliculas_template</field>
        <field name="print_report_name">'Pelicula - %s' % (object.name)</field>

        <field name="binding_model_id" ref="model_upomax_pelicula"/>
        <field name="binding_type">report</field>
    </record>
