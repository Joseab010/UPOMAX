<odoo>
  <record id="gym_users_form_view" model="ir.ui.view">
    <field name="name">gym.users.form</field>
    <field name="model">gym.users</field>
    <field name="arch" type="xml">
      <form string="Users">
        <sheet layout="auto">
          <group>
            <field name="idcard" />
            <field name="name" />
            <field name="photo" />
            <field name="classes_ids" widget="many2many" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="gym_users_list_view" model="ir.ui.view">
    <field name="name">gym.users.list</field>
    <field name="model">gym.users</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="idcard" />
        <field name="name" />
        <field name="photo" />
        <field name="classes_ids" widget="many2many" />
      </list>
    </field>
  </record>

  <record id="users_list_action" model="ir.actions.act_window">
    <field name="name">Users</field>
    <field name="res_model">gym.users</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first user</p>
    </field>
  </record>
</odoo>