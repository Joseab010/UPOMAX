<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_gym_classes_report" model="ir.actions.report">
    <field name="name">Informe</field>
    <field name="model">gym.classes</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">gym.gym_classes_template</field>
    <field name="print_report_name">'Clase - %s' % (object.name)</field>
    <field name="attachment_use">False</field>
    <field name="attachment" eval="False"/>
    <field name="binding_model_id" ref="model_gym_classes"/>
    <field name="binding_type">report</field>
  </record>

  <record id="report_gym_users_report" model="ir.actions.report">
        <field name="name">Informe</field>
        <field name="model">gym.users</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gym.gym_users_template</field>
        <field name="print_report_name">'Usuario - %s' % (object.name)</field>
        <field name="attachment_use">False</field>
        <field name="attachment" eval="False"/>
        <field name="binding_model_id" ref="model_gym_users"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
